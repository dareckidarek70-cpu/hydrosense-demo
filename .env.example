# Copy to .env.local for local development. Use Vercel Secrets for deployments.
# Server-side OAuth client credentials. Never use a NEXT_PUBLIC_ prefix.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# The rule-based assistant works without OpenAI. Leave the optional model off
# unless the project owner explicitly enables it and provides a server-side key.
HYDROSENSE_ENABLE_AI=false
OPENAI_API_KEY=

# The same write-enabled Upstash Redis database is required across hosted versions.
# Use server-side variables only. Do not prefix them with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enable independently only after provider and production-mode validation.
HYDROSENSE_PRODUCTION_WEATHER=false
HYDROSENSE_PRODUCTION_SOIL=false
